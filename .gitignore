# ============================================================================
# Docker
# ============================================================================
.dockerignore
# ABS-239: backend/.dockerignore is load-bearing — it keeps `.env` (incl. the
# bootstrap token) out of the image build context (AC#5). It MUST be tracked, so
# override the blanket ignore above. (The blanket rule itself is the architect's
# follow-up to reconsider; this negation makes the S7 install path correct now.)
!backend/.dockerignore

# ============================================================================
# CI/CD
# ============================================================================
.github/workflows/*.local.yml

# ============================================================================
# Harness Sync Metadata (generated, not committed)
# ============================================================================
.harness-sync.json
.harness-backup/
.harness-patches/
.claude/.harness-sync.json
.claude/.harness-backup/
.claude/.harness-patches/

# Cursor IDE config is not used for this project
.cursor/

# ============================================================================
# Mock Task-Tracker Runtime State (scripts/mock-tracker.sh events snapshot)
# ============================================================================
work/.events-state

# ============================================================================
# Jira Task-Tracker Runtime State (scripts/jira-tracker.sh events snapshot)
# ============================================================================
# Status snapshot the Jira adapter diffs each `events` poll against. Runtime
# state, reconstructible from a fresh JQL sweep; never committed.
work/.jira-events-state

# ============================================================================
# Gitea Task-Tracker Runtime State (scripts/gitea-tracker.sh events snapshot)
# ============================================================================
# Status snapshot the Gitea adapter diffs each `events` poll against. Runtime
# state, reconstructible from a fresh sweep; never committed.
work/.gitea-events-state

# ============================================================================
# Tracker-Koexistenz Runtime (epic ABS-326) — shadow-mirror replay log,
# divergence reports + operator whitelist. Runtime/operator state of the
# Jira->backend migration; reconstructible or operator-local, never committed.
# ============================================================================
work/.shadow-mirror.log
work/divergence/
work/tracker-divergence-whitelist.txt

# ============================================================================
# Orchestrator Runtime (scripts/orchestrator.sh) — pure coordination, no work
# state (spec ABS-36 §7): lock dirs, kill-switch, ephemeral packet temp files.
# Reconstructible; must never be committed.
# ============================================================================
work/.orchestrator/
work/.orchestrator-stop

# Staged-suite completeness ledger (PILOT-50) — advisory scratch state recording
# which staged-suite stages passed at which HEAD. Reconstructible; never committed.
work/.suite-stage-ledger

# ============================================================================
# Seat Scratch (ABS-253) — sanctioned default path for the tracker adapter's
# --body-file / --reason-file drafts. Write-allowlisted in
# .claude/settings.template.json; ephemeral by definition, never committed.
# ============================================================================
work/scratch/

# ============================================================================
# Evolver runtime (ABS-25) — GEP asset store + session memory
# ============================================================================
# Anchored to repo root: Evolver only creates these at the project root, and an
# unanchored `memory/` would ignore any memory/ directory at any depth in a
# consuming project (e.g. src/lib/memory/).
/.evolver/
/memory/

# ============================================================================
# Profile activation (ABS-37) — local/per-environment, not committed
# ============================================================================
# Written by `scripts/profile.sh set <name>`; absence means the neutral
# default. Each clone/CI environment chooses its own active profile.
/.active-profile

# ============================================================================
# Project-Specific
# ============================================================================
# Add any project-specific files to ignore here

# Pristine vendored-boilerplate reference clone (own nested .git; used for
# manual upgrade diffing, not part of this repo's tree)
/agentic-boilerplate/

# Committed test fixtures under tests/fixtures/sync/ intentionally include a
# settings.local.json sample (harness fork-sync test data, not this repo's own
# local runtime settings) — negate so a user-global "**/.claude/settings.local.json"
# gitignore rule can't silently drop it from the index (ABS-280 fixture-integrity).
!tests/fixtures/sync/**/settings.local.json


# Graphify local extraction cache (graph.json + report are committed)
graphify-out/cache/
graphify-out/graph.html

# Orchestrator / tracker scratch state under work/
work/

# ZK Powers-of-Tau ceremony files (v0.22 #7) — regenerable, ~16MB, setup-only.
# Produced by the setup/contribute/prepare scripts in apps/zk-circuits/package.json and
# consumed only by `snarkjs groth16 setup`; nothing reads them at runtime.
*.ptau

# NOTE: *.zkey, *.wasm and *.r1cs are deliberately NOT ignored.
# apps/coordinator-api/.../zk_applications/services/zk_proofs.py loads proving keys and
# witness calculators from apps/zk-circuits/ at import time (receipt_simple_0001.zkey,
# receipt_simple_js/receipt_simple.wasm, and the ml_*/modular_* equivalents). Ignoring
# them empties ZKProofService.available_circuits and silently disables proving.
