[Unit]
Description=AITBC Production Blockchain Node
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc
Environment=PATH=/usr/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/aitbc:/opt/aitbc/apps/blockchain-node/src
# Keep $HOME under /var/lib/aitbc while ProtectHome=yes hides /home/aitbc —
# libpq cannot load ~/.postgresql certs from a hidden home and silently
# downgrades the mempool connection to plaintext under sslmode=prefer.
Environment="HOME=/var/lib/aitbc"
# Service-specific secrets (created during v0.5.1 migration from /run/aitbc/secrets/.env)
EnvironmentFile=/etc/aitbc/%N.env
# Shared chain-wide public configuration
EnvironmentFile=/etc/aitbc/blockchain.env
EnvironmentFile=/etc/aitbc/node.env
EnvironmentFile=-/etc/aitbc/blockchain-secrets.env
# Consensus-signing secrets (VALIDATOR_KEYS, PROPOSER_KEY) — scoped to blockchain services only
EnvironmentFile=-/etc/aitbc/validator-secrets.env
ExecStart=/opt/aitbc/venv/bin/python -m aitbc_chain.main
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
# Production reliability
Restart=on-failure
RestartSec=5
# Production logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-blockchain
# Production security
# ProtectHome=yes - Removed for service user compatibility
# Production performance
LimitNOFILE=65536
LimitNPROC=4096
MemoryHigh=1638M
MemoryMax=2G
CPUQuota=50%
# Security hardening (v0.5.0)
# Security hardening (v0.5.0)
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc

# Security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support

# AITBC security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectSystem=full
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc
# AITBC security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support
[Install]
WantedBy=multi-user.target
