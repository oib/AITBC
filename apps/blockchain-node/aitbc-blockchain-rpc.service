[Unit]
Description=AITBC Blockchain RPC API
After=network.target aitbc-blockchain-node.service

[Service]
Type=simple
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc
Environment=PATH=/usr/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/aitbc:/opt/aitbc/apps/blockchain-node/src
Environment=RPC_BIND_HOST=0.0.0.0
Environment=RPC_BIND_PORT=8202
EnvironmentFile=-/etc/aitbc/blockchain.env
EnvironmentFile=-/etc/aitbc/node.env
EnvironmentFile=-/etc/aitbc/%N.env
Environment=AITBC_FORCE_ENABLE_BLOCK_PRODUCTION=false
Environment=enable_block_production=false
ExecStart=/opt/aitbc/venv/bin/python -m uvicorn aitbc_chain.app:app --host ${RPC_BIND_HOST} --port ${RPC_BIND_PORT} --workers 1 --timeout-keep-alive 30 --limit-concurrency 1000 --backlog 2048 --log-level critical --no-access-log
Restart=on-failure
RestartSec=5
# Graceful shutdown should finish quickly now that the gossip backend polls
# Redis with a short timeout and app.py enforces a shutdown deadline.
# 20s is a hard ceiling to prevent the previous 90s systemd default hangs.
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=BlockchainRPC
MemoryMax=512M
# Security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Security hardening (v0.5.0)
ProtectSystem=full
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc

# Security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support
