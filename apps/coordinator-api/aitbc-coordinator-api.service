[Unit]
Description=AITBC Coordinator API
After=network.target aitbc-blockchain-node.service
Wants=aitbc-blockchain-node.service
# Requires Redis for state management (training, agent, swarm routers) - add redis.service dependency when Redis is deployed
# A failing ExecStartPre migration must give up, not retry forever: each start
# takes ~15s (migration + RestartSec), so the default burst of 5/10s never trips
# and the unit would loop indefinitely. 3 attempts in 10 minutes, then `failed`.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# ExecStartPre runs alembic; a migration rewriting a large table can exceed the
# 90s default. Postgres rolls the killed attempt back cleanly, SQLite may not —
# give migrations real headroom.
TimeoutStartSec=600
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc/apps/coordinator-api/src
Environment=PYTHONPATH=/opt/aitbc:/opt/aitbc/apps/coordinator-api/src:/opt/aitbc/packages/py/aitbc-sdk/src:/opt/aitbc/packages/py/aitbc-crypto/src
# Service-specific secrets (created during v0.5.1 migration from /run/aitbc/secrets/.env)
EnvironmentFile=/etc/aitbc/%N.env
EnvironmentFile=-/etc/aitbc/%N-override.env
# Shared chain-wide public configuration
EnvironmentFile=/etc/aitbc/blockchain.env
EnvironmentFile=-/etc/aitbc/blockchain-secrets.env
EnvironmentFile=/etc/aitbc/node.env
# Schema before service: run alembic on every start so a required migration can
# never be skipped by an ad-hoc restart or a deploy path that bypasses
# run-migrations.sh. Fails closed — a bad migration stops the start instead of
# letting the app run against an old schema (this bit us twice when
# restart-before-migrate left the API 500ing on a missing column).
# PYTHONPATH mirrors run-migrations.sh: repo root, service src, every
# packages/py/*/src; DATABASE_URL arrives via the EnvironmentFile lines above.
ExecStartPre=/bin/sh -c 'cd /opt/aitbc/apps/coordinator-api && PYTHONPATH="/opt/aitbc:/opt/aitbc/apps/coordinator-api/src:$(find /opt/aitbc/packages/py -maxdepth 2 -type d -name src 2>/dev/null | tr "\n" ":")" exec /opt/aitbc/venv/bin/alembic upgrade head'
ExecStart=/opt/aitbc/venv/bin/python -m uvicorn coordinator_api.main:app --host 127.0.0.1 --port 8203 --workers 1 --timeout-keep-alive 30 --limit-concurrency 100 --backlog 256 --log-level critical --no-access-log
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-coordinator-api
# Log rotation (v0.5.0)
LogsDirectory=aitbc
# Note: ProtectSystem=no removed for service user compatibility
# Database writes handled through proper file permissions
# Memory limits
MemoryMax=1G
# Security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# snarkjs runs a Node.js JIT that must allocate read/write/execute pages.
# MemoryDenyWriteExecute breaks V8 and causes `Check failed: 12 == (*__errno_location())`.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Security hardening (v0.5.0)
ProtectSystem=full
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc

# Note: WatchdogSec disabled - requires application-level sd_notify support
# Re-enable after adding watchdog notification to FastAPI lifespan

[Install]
WantedBy=multi-user.target
