# AITBC simple-exchange environment example (no secrets; copy to /etc/aitbc/blockchain.env)
# Bridge configuration (trusted-custodian mode by default)
BRIDGE_ETH_ADDRESS=
BRIDGE_CONTRACT_ADDRESS=
BRIDGE_FEE_RATE=0.005
BRIDGE_DEPOSIT_ENABLED=true
BRIDGE_WITHDRAW_ENABLED=false

# Optional: enable multisig custody for ETH->AIT deposits and future withdrawals.
# Values are set by the operator outside the repo; never put real private keys here.
BRIDGE_CUSTODIAN_MODE=true
BRIDGE_MULTISIG_ENABLED=false
BRIDGE_MULTISIG_THRESHOLD=2
BRIDGE_SIGNERS=0xSignerOne,0xSignerTwo,0xSignerThree
BRIDGE_SAFE_ADDRESS=

# Ethereum network for deposit instructions
ETH_NETWORK=sepolia
MIN_ETH_DEPOSIT=0.001
