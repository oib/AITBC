[Unit]
Description=AITBC FFmpeg Video Processing Service
After=network.target

[Service]
Type=simple
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc
Environment=PATH=/usr/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/aitbc
EnvironmentFile=/etc/aitbc/blockchain.env
EnvironmentFile=-/etc/aitbc/blockchain-secrets.env
EnvironmentFile=/etc/aitbc/node.env
Environment=FFMPEG_PORT=8230
Environment=FFMPEG_GPU_DEVICE=0
Environment=FFMPEG_HW_ACCEL=cuda
# Bind policy: internal service, loopback only (docs/deployment/NETWORK_POLICY.md).
Environment=FFMPEG_BIND_HOST=127.0.0.1
ExecStart=/opt/aitbc/venv/bin/python /opt/aitbc/apps/ffmpeg/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-ffmpeg
# Memory sizing, measured 2026-09-14 on node2 (the only host running this unit):
# a 300 s 1080p job (229M upload, 190M output) OOM-killed the service under the
# old MemoryMax=512M and again under a trial MemoryMax=1G -- main.py buffers the
# whole upload, transcodes with a several-hundred-MB ffmpeg child, then reads the
# whole output back for hashing, so per-request cost tracks upload size.
# Under the values below the same job peaks at 1.16G with every memory.events
# counter at 0. MemoryHigh throttles a job larger than that instead of killing
# it; MemoryMax is the backstop. Note there is no upload-size guard in the app
# (whisper has WHISPER_MAX_UPLOAD_MB; this service does not yet), so MemoryMax is
# the only bound on what an oversized upload can cost the host.
MemoryHigh=1536M
MemoryMax=2G
# Security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Security hardening (v0.5.0)
ProtectSystem=full
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc

# Security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support

[Install]
WantedBy=multi-user.target
