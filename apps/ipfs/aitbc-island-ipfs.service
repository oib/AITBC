[Unit]
Description=AITBC Island IPFS Daemon (private swarm)
After=network.target

[Service]
Type=simple
User=aitbc
Group=aitbc
Environment="IPFS_BIN=/usr/local/bin/ipfs"
Environment="ISLAND_ID=ait-hub.aitbc.bubuit.net-island"
Environment="ISLAND_IPFS_HUB=true"
Environment="ISLAND_IPFS_API_PORT=5002"
Environment="ISLAND_IPFS_GATEWAY_PORT=8081"
Environment="ISLAND_IPFS_SWARM_PORT=4002"
Environment="ISLAND_IPFS_BOOTSTRAP="
Environment="IPFS_TELEMETRY=off"
EnvironmentFile=-/etc/aitbc/%N.env
WorkingDirectory=/opt/aitbc/apps/ipfs
ExecStart=/opt/aitbc/venv/bin/python /opt/aitbc/apps/ipfs/island_ipfs_daemon.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-island-ipfs

[Install]
WantedBy=multi-user.target
