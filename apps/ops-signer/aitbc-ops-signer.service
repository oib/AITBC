# aitbc-ops-signer — bounded payment signer for agent-initiated spends.
# Installed by the operator per docs/ops/ops-signer-runbook.md. Not
# installed by this repository checkout.
[Unit]
Description=AITBC ops signer — allow-listed, capped wallet proxy
After=network.target aitbc-blockchain-rpc.service

[Service]
Type=simple
User=root
Group=root
# The wallet password arrives ONLY as a systemd credential:
# systemd decrypts /etc/aitbc/credentials/ops-wallet-pass into
# $CREDENTIALS_DIRECTORY/ops-wallet-pass, an in-memory file visible
# only to this service. It never appears in argv, env, or logs.
LoadCredentialEncrypted=ops-wallet-pass:/etc/aitbc/credentials/ops-wallet-pass
Environment="AITBC_OPS_SIGNER_ENABLED=true"
Environment="PATH=/opt/aitbc/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/aitbc:/opt/aitbc/apps/ops-signer/src"
EnvironmentFile=-/etc/aitbc/ops-signer.env
ExecStart=/opt/aitbc/venv/bin/python -m aitbc_ops_signer
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Needs rw for the ledger + audit trail only:
ReadWritePaths=/var/lib/aitbc /run
# unix socket for the API, inet for the node RPC submit:
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
