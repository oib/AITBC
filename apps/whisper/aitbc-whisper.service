[Unit]
Description=AITBC Whisper Transcription Service
After=network.target

[Service]
Type=simple
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc/apps/whisper
Environment="PATH=/opt/aitbc/venv/bin"
Environment="PYTHONPATH=/opt/aitbc:/opt/aitbc/apps/whisper:$PYTHONPATH"
Environment="WHISPER_MODEL=base"
Environment="WHISPER_DEVICE=cuda"
Environment="WHISPER_COMPUTE_TYPE=float16"
Environment="HF_HOME=/var/lib/aitbc/whisper-cache"
Environment="TRANSFORMERS_CACHE=/var/lib/aitbc/whisper-cache"
# Bind policy: internal service, loopback only (docs/deployment/NETWORK_POLICY.md).
Environment=WHISPER_BIND_HOST=127.0.0.1
ExecStart=/opt/aitbc/venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-whisper
# Memory caps, sized from measurement rather than from a round number. The loaded
# model plus the CUDA context peaks near 1.2G before a single request arrives, and
# each request adds roughly 1G per ten minutes of audio: faster-whisper decodes the
# whole clip, and the endpoint reads the whole upload before touching it. The old
# MemoryMax=1G did not fit even the idle floor, so the cgroup reclaimed continuously
# (memory.events max=3121, 27k file refaults) while never being OOM-killed -- the
# failure mode was permanent thrashing, which reads as "healthy" in systemctl status.
# MemoryHigh is the throttling band: past it the kernel applies reclaim pressure and
# an unusually long clip finishes slowly instead of dying. MemoryMax remains the
# backstop, and bounds what an oversized upload can cost the rest of the host.
MemoryHigh=2G
MemoryMax=3G
# Security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Security hardening (v0.5.0)
ProtectSystem=full
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc

# Security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support

[Install]
WantedBy=multi-user.target
