[Unit]
Description=AITBC Whisper Transcription Service
After=network.target

[Service]
Type=simple
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc/apps/whisper
Environment="PATH=/opt/aitbc/venv/bin"
Environment="PYTHONPATH=/opt/aitbc:/opt/aitbc/apps/whisper:$PYTHONPATH"
Environment="WHISPER_MODEL=base"
Environment="WHISPER_DEVICE=cuda"
Environment="WHISPER_COMPUTE_TYPE=float16"
Environment="HF_HOME=/var/lib/aitbc/whisper-cache"
Environment="TRANSFORMERS_CACHE=/var/lib/aitbc/whisper-cache"
# Bind policy: internal service, loopback only (docs/deployment/NETWORK_POLICY.md).
Environment=WHISPER_BIND_HOST=127.0.0.1
ExecStart=/opt/aitbc/venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-whisper
# Memory caps, sized from measurement rather than from a round number. The loaded
# model and CUDA context hold ~730M resident; a request adds roughly 1G of
# transient allocation per ten minutes of audio, because faster-whisper decodes the
# whole clip before transcribing any of it. Cost tracks clip length, not
# concurrency -- parallel requests serialise on the model and cost little more than
# the longest one of them alone.
#
# The old MemoryMax=1G left ~270M for a transient that wants ~1G, so the cgroup
# reclaimed continuously rather than ever being OOM-killed: memory.events max=3121
# and 27k file refaults, while systemctl reported the unit active and healthy.
# Permanent thrashing is what a hard cap below the working set produces, and
# nothing short of reading memory.events makes it visible.
#
# MemoryHigh is the throttling band: a ten-minute clip peaks near 1.34G, so 2G
# means an unusually long one is slowed by reclaim instead of killed. MemoryMax is
# the backstop. What keeps a caller from aiming at it is the endpoint's own limits,
# WHISPER_MAX_UPLOAD_MB=100 and WHISPER_MAX_AUDIO_MINUTES=15: the longest accepted
# clip costs ~2.2G all told, which crosses MemoryHigh and cannot reach MemoryMax.
# Those two and these are one setting in three places -- raise them together.
MemoryHigh=2G
MemoryMax=3G
# Security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Security hardening (v0.5.0)
ProtectSystem=full
ReadWritePaths=/opt/aitbc /var/lib/aitbc /var/log/aitbc /run/aitbc

# Security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support

[Install]
WantedBy=multi-user.target
