  "components": {
    "schemas": {
      "DelegateRequest": {
        "properties": {
          "delegator_address": {
            "type": "string",
            "title": "Delegator Address"
          },
          "delegate_address": {
            "type": "string",
            "title": "Delegate Address"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "delegator_address",
          "delegate_address",
          "amount"
        ],
        "title": "DelegateRequest",
        "description": "Request body for voting-power delegation. See ``StakeRequest`` for why this is a model."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "description": "Health check response"
      },
      "PropagateRequest": {
        "properties": {
          "target_chains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Target Chains"
          }
        },
        "type": "object",
        "required": [
          "target_chains"
        ],
        "title": "PropagateRequest",
        "description": "Request body for cross-chain proposal propagation."
      },
      "StakeRequest": {
        "properties": {
          "staker_address": {
            "type": "string",
            "title": "Staker Address"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount"
          },
          "lock_period_days": {
            "type": "integer",
            "title": "Lock Period Days"
          }
        },
        "type": "object",
        "required": [
          "staker_address",
          "amount",
          "lock_period_days"
        ],
        "title": "StakeRequest",
        "description": "Request body for token staking.\n\nDeclared as a body model rather than bare scalars: FastAPI reads scalar\nparameters as *query* parameters, so this endpoint required its payload in the\nquery string while its only caller \u2014 ``aitbc governance stake`` \u2014 posts JSON.\nEvery invocation got a 422."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
