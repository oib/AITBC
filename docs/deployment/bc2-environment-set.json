{
  "version": 1,
  "doc": "docs/deployment/bc2-environment-set.md",
  "hosts": ["hub", "hub1", "node0", "node1", "node2"],
  "units": [
    "aitbc-blockchain-node",
    "aitbc-blockchain-rpc",
    "aitbc-blockchain-p2p",
    "aitbc-coordinator-api",
    "aitbc-exchange",
    "aitbc-market",
