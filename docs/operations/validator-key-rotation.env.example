# Validator / recovery key environment template (G6)
#
# This file is a placeholder example.  Copy it to a host-local, non-git path
# such as /etc/aitbc/blockchain.env and fill in values from your secrets manager.
# NEVER commit values into the repository.

# Public validator identity (safe to share)
VALIDATOR_ADDRESS=<validator-checksum-address>
VALIDATOR_PUBLIC_KEY=<secp256k1-public-key-hex>

# Private key material (DO NOT COMMIT)
VALIDATOR_PRIVATE_KEY=<validator-private-key-hex>

# Optional: explicit recovery key if it is distinct from the validator key
VALIDATOR_RECOVERY_PRIVATE_KEY=<recovery-private-key-hex>

# Chain genesis / settlement secrets (hub node only)
GENESIS_PRIVATE_KEY=<genesis-private-key-hex>
GENESIS_WALLET_PRIVATE_KEY=<genesis-wallet-private-key-hex>

# Escrow release key (hub node only)
ESCROW_RELEASE_PRIVATE_KEY=<escrow-release-private-key-hex>

# Bridge admin key (hub / island nodes)
BRIDGE_ADMIN_PRIVATE_KEY=<bridge-admin-private-key-hex>
