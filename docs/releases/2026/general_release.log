   ```

2. **Configure governance**
   ```bash
   # /etc/aitbc/governance.env
   BLOCKCHAIN_RPC_URL=http://localhost:8202
   DEFAULT_CHAIN_ID=ait-hub
   VOTING_PERIOD=7200  # blocks (~2 days at 2s block time)
   QUORUM_PERCENT=30
   APPROVAL_PERCENT=50
   TIMELOCK_BLOCKS=86400  # 48h at 2s block time
   ```

3. **Restart services**
   ```bash
   systemctl restart aitbc-governance
   ```


