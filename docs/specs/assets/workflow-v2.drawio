        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid — automated transition (orchestrator)&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;orange — bounce / rejection loop (per-ticket rework counter: 3 → Needs PO Decision)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;dashed gray — follow-up recommendation&lt;/font&gt;&lt;br&gt;dashed border — conditional stage (orchestrator SKIP-FORWARD when not flagged)" vertex="1">
          <mxGeometry height="160" width="620" y="-240" as="geometry" />
        </mxCell>
        <mxCell id="opanel" parent="1" style="rounded=1;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff0e6;strokeColor=#d79b00;" value="&lt;b&gt;Orchestrator — runs every transition &amp;amp; spawn&lt;/b&gt;&lt;br&gt;extended status→role map (each stage below = one status + one spawned role)&lt;br&gt;JOIN rule (sweep): last child story Done → epic → Epic Integration&lt;br&gt;SKIP-FORWARD: unflagged conditional stages re-transitioned by the loop, no spawn&lt;br&gt;rework counter: any bounce +1, at 3 → Needs PO Decision · stall detection → Needs PO Decision&lt;br&gt;Blocked (any stage) → TDM (once per entry) · safety gates: per-day budget, concurrency, iteration guard&lt;br&gt;NOTIFY: ready-to-test + escalation inbox" vertex="1">
          <mxGeometry height="160" width="780" x="2240" y="-240" as="geometry" />
