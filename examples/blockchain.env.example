# AITBC Blockchain Configuration — generic example
# Neutral defaults only: no island membership, role, or peer endpoint is
# assumed here. Set CHAIN_ID and the identity/peer lines for your network
# (for a follower joining an existing island, see
# examples/blockchain.env.open-island instead).
# Lines are consumed by systemd EnvironmentFile= — keep comments on their
# own line; an inline "#" becomes part of the value.

# Chain identity
CHAIN_ID=ait-testnet

# Network binds
RPC_BIND_HOST=0.0.0.0
RPC_BIND_PORT=8202
P2P_BIND_HOST=0.0.0.0
P2P_BIND_PORT=7070
P2P_PEERS=auto

# Block production (standalone default; followers set this false)
ENABLE_BLOCK_PRODUCTION=true
BLOCK_TIME_SECONDS=6
PROPOSER_ID=ait1<unique-proposer-id>
SUBSCRIPTION_ENABLED=true

# Bridge lock controls (read by aitbc-blockchain-rpc at startup; a change
# needs an rpc restart to take effect)
# true fences off NEW bridge locks while refunds, status reads and the
# confirm path stay available. false leaves locks open.
BRIDGE_LOCKS_PAUSED=false
# Per-lock maximum in compute units (1 AIT = 36,000,000 units; 0 = unlimited).
# 36,000,000,000 units = 1,000 AIT — the recommended bound.
BRIDGE_MAX_LOCK_AMOUNT=36000000000
