# AITBC Blockchain Configuration - open-island follower template
# This file is safe to distribute publicly. The hub serves a sanitized copy
# (with live allowlisted values incl. FOLLOWER_API_KEY) at
# https://hub.example.net/agent/bootstrap.env — rendered by
# scripts/ops/render-bootstrap-env.sh.

# Chain identity
CHAIN_ID=ait-localnet
ISLAND_ID=ait-localnet-island
SUPPORTED_CHAINS=ait-localnet

# Node profile
BLOCKCHAIN_MODE=follower
MARKET_ROLE=customer
HARDWARE_PROFILE=nogpu

# Subscription (how followers receive blocks)
subscription_enabled=true
subscription_transport=websocket

# Gossip (followers do not run the validator mesh; this is the hub's gossip endpoint)
GOSSIP_BACKEND=websocket
GOSSIP_WEBSOCKET_URL=wss://hub.example.net/rpc/gossip/ws

# Public block production flags (must be false for followers)
ENABLE_BLOCK_PRODUCTION=false
BLOCK_PRODUCTION_CHAINS=

# Sync and safety
AUTO_SYNC_ENABLED=true
SYNC_STATE_ROOT_VALIDATION_ENABLED=true
BLOCK_SCOPED_PREREGISTERED_TRANSACTIONS=true
