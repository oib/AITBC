# AITBC public vhost — reference configuration.
#
# Regenerated 2026-09-26 from the deployed hub vhost so it stays an honest
# reference: every location below exists in production. Host-specific values
# (server_name, real-IP sources, allowlists, token includes) are sanitized —
# replace them for your own deployment.
#
# GPU nodes additionally expose /v1/gpu/ (see the commented block below);
# the hub has no GPU service, so it is commented out here.

upstream api_gateway {
    server 127.0.0.1:8201;
}

upstream blockchain_rpc {
    server 127.0.0.1:8202;
}

upstream coordinator_api {
    server 127.0.0.1:8203;
}

upstream wallet_service {
    server 127.0.0.1:8108;
}

upstream blockchain_explorer {
    server 127.0.0.1:8100;
}

upstream agent_coordinator {
    server 127.0.0.1:8107;
}

upstream marketplace_service {
    server 127.0.0.1:8102;
}

upstream exchange_service {
    server 127.0.0.1:8106;
}

upstream pool_hub {
    server 127.0.0.1:8210;
}

# Connection-upgrade map (http context — ships as conf.d/websocket-upgrade.conf
# on the deployed hub): emits "upgrade" when the client sent an Upgrade header,
# "close" otherwise. Lets one location serve plain HTTP and WebSocket without
# per-route header duplication. Required by the /agent/api/v1/ WS locations.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    listen [::]:80;

    # Get real client IP from proxy headers. Trust only the bridge gateway of
    # whichever host terminates TLS in front of this container. The values
    # below are RFC 5737 documentation addresses and match nothing: replace
    # them with your own bridge gateways. Leaving them unmatched only costs
    # client-IP accuracy in logs, whereas trusting a range you do not control
    # lets a client spoof its address via X-Forwarded-For — so an address you
    # do not control must never be listed here.
    set_real_ip_from 192.0.2.1;
    set_real_ip_from 198.51.100.1;
    real_ip_header X-Real-IP;
    real_ip_recursive on;
    server_name _;
    # Defines $aitbc_rw_token for the = /prom-write block below. The deployed
    # hub keeps the bearer token in this separate include; create it (or drop
    # the /prom-write block) before enabling.
    # include /etc/nginx/aitbc-remote-write-token.conf;
    root /opt/aitbc/website;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Compression -- gzip on is set at http level; without gzip_types only
    # text/html qualifies, and without gzip_proxied nothing is compressed at
    # all because every request arrives via the TLS-terminating bridge proxy.
    gzip_types text/css application/javascript application/json application/ld+json image/svg+xml text/xml application/xml text/plain;
    gzip_proxied any;
    gzip_min_length 512;

    # ── Agent API (Machine-readable for autonomous agents) ───

    location /health {
        proxy_pass http://agent_coordinator/health;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /openapi.json {
        proxy_pass http://agent_coordinator/openapi.json;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /agent/openapi.json {
        proxy_pass http://agent_coordinator/openapi.json;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/reputation/ {
        proxy_pass http://coordinator_api/v1/reputation/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }


    # -- Dashboard / Customer / Shop API routes (P1.2)
    location /v1/jobs {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }
    location /v1/payments {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }


    location /v1/miners/ {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    location /v1/monitoring/ {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # 2026-09-25: /v1/bridge/deposits and /v1/bridge/withdrawals enumerate every
    # bridge record (ETH from_address paired with AIT recipient, uncapped limit).
    # Per-hash lookups stay public; the enumerable indexes are operator-only,
    # same policy as /v1/wallets below.
    location ~ ^/v1/bridge/(deposits|withdrawals)/?$ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://wallet_service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Same routes reachable via the /exchange/ -> wallet_service/ prefix strip.
    location ~ ^/exchange/v1/(exchange/deposits|bridge/deposits|bridge/withdrawals)/?$ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        rewrite ^/exchange/(.*)$ /$1 break;
        proxy_pass http://wallet_service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /v1/wallets {
        # 2026-09-14: GET /v1/wallets and GET /v1/wallets/{id}/balance were the
        # only ungated routes on this vhost; every write already requires X-API-Key.
        # Internal consumers reach the daemon directly on 127.0.0.1:8108 and never
        # traverse nginx, so restricting this prefix breaks no local caller.
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://wallet_service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # Agent-coordinator's public /v1 families — the old /v1/ catch-all sent
    # every unknown /v1/* here; unknown families now get an explicit 404.
    location ~ ^/v1/(agents|ai|alerts|auth|consensus|metrics|protected|roles|sla|system|tasks|users|advanced-features)(/|$) {
        proxy_pass http://agent_coordinator;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/ {
        return 404;
    }

    # Self-serve bootstrap (V23-58 still applies to real env files):
    # bootstrap.env is a sanitized allowlist-rendered copy made by
    # scripts/ops/render-bootstrap-env.sh — the node's real
    # /etc/aitbc/blockchain.env carries PROPOSER_KEY/VALIDATOR_KEYS and must
    # never be aliased. genesis.json is public chain data; aliasing the live
    # file keeps it always current. Exact-match `=` blocks take precedence
    # over the deny regex below.
    location = /agent/bootstrap.env {
        alias /etc/aitbc/bootstrap.env;
        add_header Content-Type "text/plain; charset=utf-8";
        add_header Access-Control-Allow-Origin * always;
    }

    location = /agent/genesis.json {
        alias /etc/aitbc/genesis.json;
        add_header Content-Type "application/json; charset=utf-8";
        add_header Access-Control-Allow-Origin * always;
    }

    # Everything else env/secret-like under /agent stays dead: the real
    # blockchain.env and blockchain-secrets.env carry live key material on
    # this hub, so no env or secrets file may ever be reachable under the
    # /agent mount. Regex beats plain prefix locations; a future
    # `location /agent/ { alias ...; }` still cannot expose one.
    location ~ ^/agent/.*(\.env|secret) {
        return 404;
    }

    # Redirect /agent/ to main site
    location = /agent/ {
        return 301 /;
    }

    # ── Agent Coordinator ─────────────────────────────────────────────
    # Canonical public namespace: /agent/api/v1/<route> maps to the app's
    # /api/v1/agent/<route>. One prefix rule covers the whole agent domain
    # (auth, keys, messages, workflows, coin-requests, ws) including the
    # WebSocket streams, which ride the mapped Upgrade/Connection headers.
    # Adds no new exposure: /api/v1/agent/* was already fully reachable via
    # the compat passthrough below.
    location /agent/api/v1/ {
        proxy_pass http://agent_coordinator/api/v1/agent/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;
        client_max_body_size 5M;
        # Upstream 307s emit absolute /api/v1/agent/... Locations — rewrite
        # them back into the canonical public namespace.
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/api/v1/$1;
    }

    # DEPRECATED compat — clients configured with
    # agent_coordinator_url=.../agent append the internal
    # /api/v1/agent/... path themselves, producing the doubled
    # /agent/api/v1/agent/... URL. Longer prefix keeps winning those
    # requests; remove once clients are repointed at /agent/api/v1/.
    location /agent/api/v1/agent/ {
        proxy_pass http://agent_coordinator/api/v1/agent/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;
        client_max_body_size 5M;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/api/v1/agent/$1;
    }

    # Agent Coordinator registry (/v1/agents/*) under the /agent mount,
    # so agent_coordinator_url=.../agent serves registry + messaging from one base.
    location /agent/v1/ {
        proxy_pass http://agent_coordinator/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # DEPRECATED short aliases — /agent/messages/, /agent/auth/, etc.
    # Canonical is /agent/api/v1/<route>. Kept working; check access logs
    # for remaining consumers before deleting. The env/secret deny regex
    # earlier in this file still wins for anything env-like under /agent/.
    location ~ ^/agent/(messages|auth|keys|workflows|coin-requests|ws)(/.*)?$ {
        proxy_pass http://agent_coordinator/api/v1/agent/$1$2;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;
        client_max_body_size 5M;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
    }

    # ── API Gateway Reverse Proxy ─────────────────────────────

    location /api/ {
        proxy_pass http://api_gateway/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Blockchain RPC Reverse Proxy ────────────────────────

    # ── Blockchain RPC Reverse Proxy ────────────────────────

    # WebSocket routes for real-time block push and authenticated validator gossip.
    # /rpc/subscribe/ws is for public follower block delivery.
    # /rpc/gossip/ws is for authenticated validator consensus gossip.
    location ~ ^/rpc/(subscribe/ws|gossip/ws)$ {
        proxy_pass http://127.0.0.1:8202;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }


    # ── Escrow RPC allowlist (CHOKE-POINT: public mutation endpoint exposure) ─
    # Read-only escrow state (GET) is left to the application auth layer.
    # All mutating escrow calls (create, release, refund) are source-IP allowlisted
    # so follower/coordinator nodes keep working while the public internet is blocked.
    location /rpc/escrow/ {
        limit_except GET {
            allow 127.0.0.1;        # coordinator / localhost
            allow ::1;              # IPv6 localhost
            allow 192.0.2.10;       # hub node (example — replace)
            allow 192.0.2.11;       # second hub (example — replace)
            allow 198.51.100.20;    # follower egress (example — replace)
            allow 203.0.113.0/24;   # internal network (example — replace)
            deny all;               # block public internet
        }

        proxy_pass http://blockchain_rpc/rpc/escrow/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

# HTTP RPC routes (subscribe, heartbeat, blocks, head, etc.)
    location /rpc/ {
        proxy_pass http://blockchain_rpc/rpc/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Coordinator API (Legacy Failover) ─────────────────────

    location /c/ {
        proxy_pass http://coordinator_api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Prefix /c;
        client_max_body_size 100M;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Exchange API (simple_exchange :8106) ─────────────────────
    # Wallet's own /v1/exchange/* endpoints stay reachable via the
    # /exchange/ prefix below (wallet_service fronts its whole app there).

    location /v1/exchange/ {
        proxy_pass http://exchange_service/v1/exchange/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Blockchain Explorer API ────────────────────────────────

    location /explorer-api/ {
        proxy_pass http://blockchain_explorer/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Marketplace Service Ports (GPU Services) ─────────────────────

    # GPU nodes only: the local GPU inventory service listens on :8101.
    # The hub has no GPU service, so this stays commented out there.
    # location /v1/gpu/ {
    #     proxy_pass http://127.0.0.1:8101;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    #     add_header Access-Control-Allow-Origin * always;
    #     add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    #     add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    # }

    location /ollama/ {
        proxy_pass http://127.0.0.1:11434/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # Whisper service (speech recognition)
    location /whisper/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # FFmpeg service (video transcoding)
    location /ffmpeg/ {
        proxy_pass http://127.0.0.1:9000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # PeerTube Pruner service
    location /peertube-pruner/ {
        proxy_pass http://127.0.0.1:9500/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Marketplace API ───────────────────────────────────────

    # Coordinator-owned marketplace families (GPU marketplace, providers,
    # bonds, pricing) — everything else under /v1/market/ belongs to
    # the marketplace service below. The regex location wins over the
    # plain prefix block for these sub-paths.
    location ~ ^/v1/market/(gpu|providers|bonds|miner-offers|native-energy|orders|pricing|sync-offers)(/|$) {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # Coordinator owns the public /v1/market/offers + /plugins names
    # (operator decision 2026-09-23). Exact-match beats the /v1/market/
    # prefix below, so offers/plugins subroutes still reach :8102.
    location = /v1/market/offers {
        proxy_pass http://coordinator_api/v1/market/offers;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    location = /v1/market/plugins {
        proxy_pass http://coordinator_api/v1/market/plugins;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    location /v1/market/ {
        proxy_pass http://marketplace_service/v1/market/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Exchange API (Bridge, Price, History) ─────────────────────

    location /v1/bridge/ {
        proxy_pass http://wallet_service/v1/bridge/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    location /v1/exchange/history {
        proxy_pass http://exchange_service/v1/exchange/history;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }



    location /exchange/ {
        proxy_pass http://wallet_service/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }
    location /exchange/price.json {
        proxy_pass http://exchange_service/exchange/price.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }




    # Pool Hub Reverse Proxy
    location /pool-hub/ {
        proxy_pass http://pool_hub/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # Public coin-request endpoints for open-island funding
    location /api/v1/agent/coin-requests/ {
        proxy_pass http://agent_coordinator/api/v1/agent/coin-requests/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept, x-api-key" always;
    }

    # Paid agent-to-agent delegation messaging (send/inbox/read).
    # Same trust level as the public /v1/ coordinator routes; the WS stream
    # stays under /agent/api/v1/agent/messages/stream.
    location /api/v1/agent/messages/ {
        proxy_pass http://agent_coordinator/api/v1/agent/messages/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept, x-api-key" always;
        client_max_body_size 5M;
    }

    # Catch-all for the rest of the app's /api/v1/agent/ namespace (auth, keys,
    # workflows, ws/status). hub_agent_url() resolves agent_coordinator_url to
    # https://<hub>/api/v1/agent, and clients holding that base append short
    # paths like /auth/nonce — without this block they fell through to the API
    # gateway and 404'd. Longer prefixes above keep winning for messages and
    # coin-requests; every route here is equally reachable via /agent/api/v1/agent/.
    location /api/v1/agent/ {
        proxy_pass http://agent_coordinator/api/v1/agent/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        client_max_body_size 5M;
    }

    # Prometheus remote-write receiver (hub is the central store).
    # IP allowlist + bearer token. The whole block is commented out because it
    # references $aitbc_rw_token, which only exists once the
    # aitbc-remote-write-token.conf include near server_name is enabled —
    # uncomment both together.
    # location = /prom-write {
    #     allow 198.51.100.20;     # follower egress (example — replace)
    #     allow 192.0.2.10;        # hub node (example — replace)
    #     allow 127.0.0.1;
    #     deny all;
    #     if ($http_authorization != "Bearer $aitbc_rw_token") { return 401; }
    #     proxy_pass http://127.0.0.1:9090/api/v1/write;
    #     proxy_set_header X-Real-IP $remote_addr;
    # }

    # ── Web dashboards ────────────────────────────────────────
    # Pretty aliases for the two operator dashboards; the underlying files are
    # also served directly as /customer-dashboard.html and /shop-dashboard.html.
    location = /dashboard { return 301 /dashboard/; }
    location /dashboard/ {
        alias /opt/aitbc/website/customer-dashboard.html;
        default_type text/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /shop { return 301 /shop/; }
    location /shop/ {
        alias /opt/aitbc/website/shop-dashboard.html;
        default_type text/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location / {
        # expires sets Expires + Cache-Control: max-age -- unlike add_header
        # it does not suppress the server-level security headers for this
        # location. 1h bound since asset filenames are not fingerprinted.
        expires 1h;
        try_files $uri $uri/ =404;
    }

    # Optional host tooling (log analytics) — enable only if present.
    # include /etc/nginx/awstats-locations.conf;

}
