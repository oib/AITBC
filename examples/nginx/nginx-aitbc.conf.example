
upstream api_gateway {
    server 127.0.0.1:8201;
}

upstream blockchain_rpc {
    server 127.0.0.1:8202;
}

upstream coordinator_api {
    server 127.0.0.1:8203;
}

upstream wallet_service {
    server 127.0.0.1:8108;
}

upstream blockchain_explorer {
    server 127.0.0.1:8100;
}

upstream agent_coordinator {
    server 127.0.0.1:8107;
}

upstream marketplace_service {
    server 127.0.0.1:8102;
}

upstream gpu_service {
    server 127.0.0.1:8101;
}

upstream whisper {
    server 127.0.0.1:8110;
}

upstream ffmpeg {
    server 127.0.0.1:8230;
}

upstream hermes_agent {
    server 127.0.0.1:8270;
}

upstream ollama {
    server 127.0.0.1:11434;
}

server {
    listen 80;
    listen [::]:80;

    # Get real client IP from proxy headers. Trust only the incus bridge
    # gateway of whichever host terminates TLS in front of this container.
    # The values below are RFC 5737 documentation addresses and match nothing:
    # replace them with your own bridge gateways. Leaving them unmatched only
    # costs client-IP accuracy in logs, whereas trusting a range you do not
    # control lets a client spoof its address via X-Forwarded-For -- so an
    # address you do not control must never be listed here.
    set_real_ip_from 192.0.2.1;
    set_real_ip_from 198.51.100.1;
    real_ip_header X-Real-IP;
    real_ip_recursive on;
    server_name _;
    root /opt/aitbc/website;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # ── Agent API (Machine-readable for autonomous agents) ───

    location /health {
        proxy_pass http://agent_coordinator/health;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /openapi.json {
        proxy_pass http://agent_coordinator/openapi.json;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /agent/openapi.json {
        proxy_pass http://agent_coordinator/openapi.json;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Dashboard / customer / shop API routes (P1.2)
    location /v1/jobs {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/miners/ {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/monitoring/ {
        proxy_pass http://coordinator_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/gpu/ {
        proxy_pass http://gpu_service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/ {
        proxy_pass http://agent_coordinator/v1/;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Wallet endpoints are served by the wallet daemon, not agent-coordinator.
    location /v1/wallets {
        # The wallet daemon gates every write route behind X-API-Key, but the
        # list and balance reads are ungated by design for local tooling. Keep
        # this prefix off the public vhost: in-process consumers talk to the
        # daemon directly on its loopback port and never traverse nginx.
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://wallet_service/v1/wallets;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /v1/chains/ {
        proxy_pass http://wallet_service/v1/chains/;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # ── Optional public bootstrap (DISABLED by default) ─────────────────────
    #
    # The reference hub does not serve bootstrap files: GET /agent/blockchain.env,
    # /agent/genesis.json and /agent/chain.db return 404, and /rpc/network-info
    # reports "provisioning": "out_of_band". Chain configuration and credentials
    # are issued by the hub operator over an authenticated channel — see
    # docs/agent/guides/open-island-joining-guide.md.
    #
    # If you choose to offer self-serve joining, NEVER alias the node's real
    # /etc/aitbc/blockchain.env: on a hub it carries live consensus key material
    # (PROPOSER_KEY, VALIDATOR_KEYS, FOLLOWER_API_KEY). Publish a sanitized
    # follower-only copy instead, e.g.:
    #
    #   location = /agent/blockchain.env {
    #       alias /etc/aitbc/bootstrap.env;   # CHAIN_ID, HUB_DISCOVERY_URL, ... only
    #       add_header Content-Type "text/plain; charset=utf-8";
    #       add_header Access-Control-Allow-Origin * always;
    #   }
    #   location = /agent/genesis.json {
    #       alias /etc/aitbc/genesis.json;    # genesis is public data
    #       add_header Content-Type "application/json; charset=utf-8";
    #       add_header Access-Control-Allow-Origin * always;
    #   }
    #
    # An exact-match `location =` overrides the deny regex below, so the blocks
    # above still win when uncommented.

    # Env and secrets files are NOT served under /agent, and must never be added
    # back (V23-58). blockchain-secrets.env previously was, unauthenticated and
    # with CORS wide open. The values it holds are live credentials, not
    # configuration: COORDINATOR_API_KEY authenticates as role `miner` via the
    # X-Api-Key dependency in aitbc/auth/dependencies.py, and either value alone
    # authorises the agent-coordinator coin-request and websocket endpoints,
    # which accept COORDINATOR_API_KEY *or* SECRET_KEY. On the hub, the real
    # blockchain.env additionally carries PROPOSER_KEY and VALIDATOR_KEYS.
    # Publishing any of these grants those roles/keys to anyone who runs curl.
    #
    # The regex below is deliberate belt-and-braces. nginx checks regex
    # locations before plain prefix locations, so a future
    # `location /agent/ { alias /etc/aitbc/; }` -- the obvious way someone
    # re-introduces this -- still cannot expose an env or secrets file. To
    # publish a specific file anyway, use an exact-match `location =` block
    # (exact matches take precedence over regexes).
    location ~ ^/agent/.*(\.env|secret) {
        return 404;
    }

    # Redirect /agent/ to main site
    location = /agent/ {
        return 301 /;
    }

    # ── Agent Coordinator WebSocket ───────────────────────────
    # Real-time agent messaging (PING/PONG) and presence tracking.
    # Preferred public form: wss://<hub>/agent/messages/stream
    # Legacy form (still proxied below): /agent/api/v1/agent/messages/stream
    location /agent/api/v1/agent/messages/stream {
        proxy_pass http://agent_coordinator/api/v1/agent/messages/stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /agent/api/v1/agent/presence/stream {
        proxy_pass http://agent_coordinator/api/v1/agent/presence/stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Agent Coordinator registry (/v1/agents/*) under the /agent mount,
    # so agent_coordinator_url=.../agent serves registry + messaging from one base.
    location /agent/v1/ {
        proxy_pass http://agent_coordinator/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Agent Coordinator HTTP API (auth/nonce/login, messages, inbox, workflows, keys)
    # Prefix route — the two /stream locations above are longer prefixes and keep winning.
    location /agent/api/v1/agent/ {
        proxy_pass http://agent_coordinator/api/v1/agent/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 5M;
    }

    # ── Agent Coordinator short aliases ──────────────────────
    # The app's routers live under /api/v1/agent/, which made the public path
    # /agent/api/v1/agent/... — the doubled "agent" is the nginx service mount
    # stacked on the app's own namespace. These aliases publish the same routes
    # at /agent/<resource>/ (e.g. /agent/messages/send). The doubled prefix
    # above stays live for backward compatibility: existing
    # agent_coordinator_url=https://<hub>/agent clients append the full
    # internal /api/v1/agent/... path themselves.
    location /agent/messages/stream {
        proxy_pass http://agent_coordinator/api/v1/agent/messages/stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 10s;
        client_max_body_size 5M;
    }

    location /agent/presence/stream {
        proxy_pass http://agent_coordinator/api/v1/agent/presence/stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /agent/messages/ {
        proxy_pass http://agent_coordinator/api/v1/agent/messages/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
        client_max_body_size 5M;
    }

    location /agent/auth/ {
        proxy_pass http://agent_coordinator/api/v1/agent/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
    }

    location /agent/keys/ {
        proxy_pass http://agent_coordinator/api/v1/agent/keys/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
    }

    # No trailing slash on the prefix: the workflows list/create routes live at
    # the bare /api/v1/agent/workflows, and /workflows/ 307s onto it. The regex
    # proxy_redirect rewrites that absolute Location back under /agent/.
    location /agent/workflows {
        proxy_pass http://agent_coordinator/api/v1/agent/workflows;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
    }

    location /agent/coin-requests/ {
        proxy_pass http://agent_coordinator/api/v1/agent/coin-requests/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
    }

    location /agent/ws/ {
        proxy_pass http://agent_coordinator/api/v1/agent/ws/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_redirect ~^https?://[^/]+/api/v1/agent/(.*)$ /agent/$1;
    }

    # Public coin-request endpoints for open-island funding.
    location /api/v1/agent/coin-requests/ {
        proxy_pass http://agent_coordinator/api/v1/agent/coin-requests/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept, x-api-key" always;
    }

    # Paid agent-to-agent delegation messaging (send/inbox/read) at the root
    # mount — used by clients that strip agent_coordinator_url to the origin.
    location /api/v1/agent/messages/ {
        proxy_pass http://agent_coordinator/api/v1/agent/messages/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept, x-api-key" always;
        client_max_body_size 5M;
    }

    # Catch-all for the rest of the app's /api/v1/agent/ namespace (auth, keys,
    # workflows, ws/status). hub_agent_url() resolves agent_coordinator_url to
    # https://<hub>/api/v1/agent, and clients holding that base append short
    # paths like /auth/nonce — without this block they fall through to the API
    # gateway and 404. Longer prefixes above keep winning for messages and
    # coin-requests; every route here is equally reachable via /agent/api/v1/agent/.
    location /api/v1/agent/ {
        proxy_pass http://agent_coordinator/api/v1/agent/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Api-Key $http_x_api_key;
        client_max_body_size 5M;
    }

    # ── API Gateway Reverse Proxy ─────────────────────────────

    location /api/ {
        proxy_pass http://api_gateway/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Blockchain RPC Reverse Proxy ────────────────────────

    # ── Blockchain RPC Reverse Proxy ────────────────────────

    # WebSocket routes for real-time block push and validator gossip.
    # /rpc/subscribe/ws is for public follower block delivery.
    # /rpc/gossip/ws is for authenticated validator consensus gossip.
    location ~ ^/rpc/(subscribe/ws|gossip/ws)$ {
        proxy_pass http://127.0.0.1:8202;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Cap WebSocket message and idle lifetimes.
        proxy_connect_timeout 10s;
        client_max_body_size 5M;
    }

    # HTTP RPC routes (subscribe, heartbeat, blocks, head, etc.)
    location /rpc/ {
        proxy_pass http://blockchain_rpc/rpc/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Coordinator API (Legacy Failover) ─────────────────────

    location /c/ {
        proxy_pass http://coordinator_api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Wallet Service Exchange API ─────────────────────────────

    location /v1/exchange/ {
        proxy_pass http://wallet_service/v1/exchange/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Blockchain Explorer API ────────────────────────────────

    location /explorer-api/ {
        proxy_pass http://blockchain_explorer/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Marketplace Service Ports (GPU Services) ─────────────────────

    # Ollama service (AI inference)
    location /ollama/ {
        proxy_pass http://127.0.0.1:11434/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # Whisper transcription service
    location /whisper/ {
        client_max_body_size 500M;
        rewrite ^/whisper/(.*) /$1 break;
        proxy_pass http://whisper;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # FFmpeg video processing service
    location /ffmpeg/ {
        client_max_body_size 500M;
        rewrite ^/ffmpeg/(.*) /$1 break;
        proxy_pass http://ffmpeg;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # Hermes Agent one-shot service
    location /hermes/ {
        client_max_body_size 50M;
        rewrite ^/hermes/(.*) /$1 break;
        proxy_pass http://hermes_agent;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }


    # ── Marketplace API ───────────────────────────────────────

    location /v1/marketplace/ {
        proxy_pass http://marketplace_service/v1/marketplace/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Exchange API (Bridge, Price, History) ─────────────────────

    location /v1/bridge/ {
        proxy_pass http://127.0.0.1:8106/v1/bridge/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    location /v1/exchange/history {
        proxy_pass http://127.0.0.1:8106/v1/exchange/history;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    location /exchange/price.json {
        proxy_pass http://127.0.0.1:8106/exchange/price.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
    }

    # ── Web dashboards ────────────────────────────────────────

    location /dashboard/ {
        alias /opt/aitbc/website/customer-dashboard.html;
        default_type text/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /shop/ {
        alias /opt/aitbc/website/shop-dashboard.html;
        default_type text/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
