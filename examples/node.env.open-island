# AITBC Node-Specific Environment Configuration - open-island follower template
# This file contains settings unique to this node. Do not share it between nodes.

# Node identity (the setup script replaces this with a unique value)
NODE_ID=aitbc-follower
P2P_NODE_ID=aitbc-follower

# P2P bind (followers do not accept P2P connections by default)
P2P_BIND_HOST=0.0.0.0
P2P_BIND_PORT=7070

# The hub this follower joins. The setup script sets this from --open-island.
DEFAULT_PEER_RPC_URL=

# Public RPC endpoints used by the follower
RPC_PUBLIC_ENDPOINT=https://hub.aitbc.bubuit.net/rpc
BLOCKCHAIN_RPC_URL=https://hub.aitbc.bubuit.net/rpc

# Followers do not produce blocks
ENABLE_BLOCK_PRODUCTION=false
BLOCK_PRODUCTION_CHAINS=

# Followers do not run the validator gossip broker; subscription uses the hub websocket.
GOSSIP_BACKEND=websocket
