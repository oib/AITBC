# AITBC website branding — install as /etc/aitbc/website.env (optional).
#
# When this file exists, scripts/ops/render-website.sh (called by update.sh
# after every pull) rewrites the committed branding tokens in the website/
# static files: absolute URLs in sitemap.xml, robots.txt, llms.txt,
# structured-data.jsonld, index.html, follower-api-key-announcement.html, and
# the chainId fallbacks in config.js and dashboard.js. With no file present
# the committed values are served unchanged.

# Public domain this site is served on — no scheme, no trailing slash.
# Fallback when unset: AITBC_HOSTNAME, then HUB_DISCOVERY_URL from node.env.
WEBSITE_DOMAIN=hub.example.net

# Chain id used by the explorer/marketplace pages.
# Fallback when unset: CHAIN_ID from node.env.
WEBSITE_CHAIN_ID=ait-hub.example.net

# Bridge payout account (0x + 40 hex) shown on bridges.html — the public
# on-chain sender of ETH→AIT payouts. Rendered into config.js.
# Fallback when unset: BRIDGE_PAYOUT_ADDRESS from node.env, then from
# aitbc-bridge-monitor.env; finally the committed default.
# Rotate together with the bridge payout account — bridges.html lists
# recent payouts by this address.
WEBSITE_BRIDGE_PAYOUT_ADDRESS=0x0000000000000000000000000000000000000000

# Public contact shown in the site footer, /rpc/network-info, and the
# report-abuse sentence on /messages.html (rendered by render-website.sh;
# left out of the page while unset).
# Read by aitbc-blockchain-rpc.service via EnvironmentFile (this file is
# optional there too — the daemon falls back to its built-in default).
# Keep this set: every render rewrites the marked contact region, and an
# unset value empties it rather than keeping the last rendered content.
CONTACT_EMAIL=operator@example.net
