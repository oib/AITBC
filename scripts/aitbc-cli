#!/bin/sh
set -euo pipefail
# Resolve relative to this script's own location rather than a hardcoded
# /opt/aitbc: the CI runner checks the repo out to its own ephemeral
# workspace, not /opt/aitbc.
script_dir="$(cd "$(dirname "$0")" && pwd)"
venv_dir="$script_dir/../venv"
. "$venv_dir/bin/activate"
# Exec the venv's own console-script by absolute path rather than relying on
# PATH lookup: some hosts have a stale/unrelated /usr/local/bin/aitbc shim
# left over from earlier manual provisioning, and "exec aitbc" would resolve
# to that instead of the venv we just activated, depending on PATH order.
exec "$venv_dir/bin/aitbc" "$@"
