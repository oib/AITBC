# nginx vhost for https://ntfy.bubuit.net on ns2 —
# install as /etc/nginx/sites-enabled/ntfy.bubuit.net (or sites-available +
# symlink, per local convention).
#
# PREREQUISITE on ns2 (one file): /etc/nginx/conf.d/aitbc-log-scrub.conf
# must define log_format aitbc_scrub — same file as SEC-14c:
#   log_format aitbc_scrub '$remote_addr - $remote_user [$time_local] '
#                          '"$request_method $uri $server_protocol" $status $body_bytes_sent '
#                          '"$http_referer" "$http_user_agent"';
# conf.d loads before sites-enabled, so the name resolves here.
#
# TLS: issued by certbot --nginx (http-01) once the :80 block below answers
# on the public name; certbot then rewrites this file's ssl_* lines.
# ntfy.bubuit.net already resolves to ns2's public IP, so http-01 works.
# Message bodies are POST bodies and never reach an access log; the topic
# name also stays out of the URL because publishers use the JSON publish
# API (see runbook §5 — never ?message= GET publishing).

server {
    listen 80;
    listen [::]:80;
    server_name ntfy.bubuit.net;

    # certbot http-01 challenge only; everything else upgrades to TLS
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ntfy.bubuit.net;

    # certbot fills these in on first issuance:
    # ssl_certificate     /etc/letsencrypt/live/ntfy.bubuit.net/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ntfy.bubuit.net/privkey.pem;

    # Scrubbed format (SEC-14c): drops the query string; ntfy auth headers
    # and tokens never enter an access log because they are headers, and the
    # publish path keeps the topic out of the URI.
    access_log /var/log/nginx/ntfy.access.log aitbc_scrub;
    error_log  /var/log/nginx/ntfy.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:2586;
        proxy_http_version 1.1;

        # client identity for ntfy rate limits (behind-proxy: true)
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # long-lived streams: websocket upgrade + long timeouts.
        # ntfy topics are consumed via ?poll=1 long-poll or ws; idle streams
        # must not be reaped by proxy timeouts.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout  12h;
        proxy_send_timeout  12h;
        proxy_connect_timeout 5s;
        proxy_buffering off;   # deliver notifications immediately
    }
}
