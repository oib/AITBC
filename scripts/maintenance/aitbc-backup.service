[Unit]
Description=AITBC Daily Backup
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
Type=oneshot
User=root
Group=root
# Optional backup knobs (BACKUP_GPG_RECIPIENT, BACKUP_OFFSITE_SCRIPT, ...)
EnvironmentFile=-/etc/aitbc/%N.env
ExecStart=/opt/aitbc/scripts/maintenance/aitbc-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aitbc-backup
# No restart — timer handles scheduling
