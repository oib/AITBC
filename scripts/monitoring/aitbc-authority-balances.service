[Unit]
Description=AITBC authority account balances for Prometheus (node_exporter textfile)
Documentation=https://github.com/oib/AITBC
After=aitbc-blockchain-rpc.service

[Service]
Type=oneshot
# Optional role:address pairs, public addresses. The exporter derives the
# escrow_settlement, bridge_release and bond_slash watch addresses plus one
# governance_executor series per governance_executors member from the live
# chain parameters every run (GET /rpc/state/snapshot), so a rotation needs no
# edit here; these entries are the fallback when the parameter read fails — the
# run still reports scrape_success 0 for a fallback role — and extra
# role:address pairs for anything else worth watching. The three extras
# below are service/validator identities that are not chain parameters, so
# they never auto-follow a rotation: update them when the identity rotates
# (governance proposer, hub validator) or is retired again.
Environment=AITBC_WATCH_ACCOUNTS=escrow_settlement:0x11741E1A83E85117712113A29954583B1f2A2B1F,bridge_release:0xCA78267E500A0cfbf603AEb34b116841A099D1ed,bond_slash:0x9aCCbF54E8564E5c9585f8833AE6b4A83cE05A04,governance_proposer:0xD8168A8bC4817B8e4fcBc966Af67F74878869BE7,validator_hub:0x2aD555A9e5208A6438b24FbdA4BC83c4c2453e64,proposer_retired:0x02B8F2C61DB19B04aB68cfb43d0605E63dE74c5B,sell_escrow:0x40c7181b639A2642294A802b1CD60C7a0d531a07
Environment=AITBC_RPC_URL=http://127.0.0.1:8202
Environment=AITBC_TEXTFILE_DIR=/var/lib/prometheus/node-exporter
ExecStart=/usr/bin/python3 /opt/aitbc/scripts/monitoring/authority-balances-textfile.py
# Exits 1 when an account could not be read or a role fell back to this list
# (both surface through aitbc_authority_scrape_success), 2 on a bad
# AITBC_WATCH_ACCOUNTS entry.
SyslogIdentifier=aitbc-authority-balances

# Reads one local HTTP endpoint and writes one file in the textfile directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prometheus/node-exporter
ProtectKernelModules=true
RestrictRealtime=true
LockPersonality=true
