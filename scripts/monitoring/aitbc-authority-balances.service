[Unit]
Description=AITBC authority account balances for Prometheus (node_exporter textfile)
Documentation=https://github.com/oib/AITBC
After=aitbc-blockchain-rpc.service

[Service]
Type=oneshot
# Optional role:address pairs, public addresses. The exporter derives the
# escrow_settlement and bridge_release watch addresses from the live chain
# parameters every run (GET /rpc/state/snapshot), so a rotation needs no edit
# here; these entries are the fallback when the parameter read fails — the run
# still reports scrape_success 0 for a fallback role — and extra role:address
# pairs for anything else worth watching.
Environment=AITBC_WATCH_ACCOUNTS=escrow_settlement:0x11741E1A83E85117712113A29954583B1f2A2B1F,bridge_release:0xCA78267E500A0cfbf603AEb34b116841A099D1ed
Environment=AITBC_RPC_URL=http://127.0.0.1:8202
Environment=AITBC_TEXTFILE_DIR=/var/lib/prometheus/node-exporter
ExecStart=/usr/bin/python3 /opt/aitbc/scripts/monitoring/authority-balances-textfile.py
# Exits 1 when an account could not be read or a role fell back to this list
# (both surface through aitbc_authority_scrape_success), 2 on a bad
# AITBC_WATCH_ACCOUNTS entry.
SyslogIdentifier=aitbc-authority-balances

# Reads one local HTTP endpoint and writes one file in the textfile directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prometheus/node-exporter
ProtectKernelModules=true
RestrictRealtime=true
LockPersonality=true
