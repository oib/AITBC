[Unit]
Description=AITBC journal error/warning counts for Prometheus (node_exporter textfile)
Documentation=https://github.com/oib/AITBC
After=systemd-journald.service

[Service]
Type=oneshot
User=aitbc
Group=aitbc
# journald's group is what lets the aitbc user read the system journal at all;
# it comes from the unit, no /etc/group edit needed.
SupplementaryGroups=systemd-journal
Environment=AITBC_TEXTFILE_DIR=/var/lib/prometheus/node-exporter
Environment="AITBC_JOURNAL_WINDOW=15 minutes ago"
ExecStart=/usr/bin/python3 /opt/aitbc/scripts/monitoring/journal-errors-textfile.py
# Exits 1 when the journal could not be read (aitbc_journal_scan_success then
# says 0).
SyslogIdentifier=aitbc-journal-errors

# Reads the system journal and writes one file in the textfile directory.
ReadWritePaths=/var/lib/prometheus/node-exporter
RestrictAddressFamilies=AF_UNIX

# AITBC security hardening (v0.5.0)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectSystem=full
ReadWritePaths=/var/lib/prometheus/node-exporter
# AITBC security hardening (v0.5.0)
# WatchdogSec=30 # Disabled - requires application-level sd_notify support
[Install]
WantedBy=multi-user.target
