[Unit]
Description=AITBC memory usage monitor
Documentation=https://gitea.bubuit.net/oib/AITBC
After=network.target

[Service]
Type=oneshot
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc
Environment=PATH=/opt/aitbc/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/aitbc/scripts/monitoring/memory-monitor.sh
# Exits 1 when a service is over its memory threshold or an OOM kill is found.
SyslogIdentifier=aitbc-memory-monitor

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
# Read-only, not inaccessible: the OOM check reads per-service oom_kill counters
# from /sys/fs/cgroup, which stays readable under this.
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectKernelTunables=true
ReadWritePaths=/var/log/aitbc

[Install]
WantedBy=multi-user.target
