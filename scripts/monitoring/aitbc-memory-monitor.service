[Unit]
Description=AITBC memory usage monitor
Documentation=https://github.com/oib/AITBC
After=network.target

[Service]
Type=oneshot
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc
Environment=PATH=/opt/aitbc/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AITBC_TEXTFILE_DIR=/var/lib/prometheus/node-exporter
ExecStart=/opt/aitbc/scripts/monitoring/memory-monitor.sh
# Exits 1 when a service is over its memory threshold or an OOM kill is found
# -- per-unit counters plus the root/user.slice/system.slice scope counters
# (MEMMON-ROOT-OOM-1: scope-level kills were invisible to the per-unit scan).
SyslogIdentifier=aitbc-memory-monitor

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
# Read-only, not inaccessible: the OOM check reads per-service oom_kill counters
# from /sys/fs/cgroup, which stays readable under this.
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectKernelTunables=true
ReadWritePaths=/var/log/aitbc /var/lib/prometheus/node-exporter

# Deliberately no [Install] section. This is a oneshot activated by
# aitbc-memory-monitor.timer, so the timer is the unit that belongs in the boot
# transaction. A WantedBy=multi-user.target here would additionally pull the
# oneshot in at every boot, on top of its schedule.
