[Unit]
Description=Re-attest the native AIT/EUR energy rate for GPU-rental quotes
Documentation=https://github.com/oib/AITBC
After=aitbc-coordinator-api.service

[Service]
Type=oneshot
User=aitbc
Group=aitbc
# Only installed on hub (After=aitbc-coordinator-api): there
# aitbc-coordinator-api.env is 600 aitbc:aitbc, readable by this user.
# On hosts where that env is root-only this unit must not be installed (#1729).
ExecStart=/opt/aitbc/scripts/monitoring/native-energy-rate-refresh.sh
