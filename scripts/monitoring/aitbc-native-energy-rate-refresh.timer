[Unit]
Description=Re-attest the native AIT/EUR energy rate twice daily
Documentation=https://gitea.bubuit.net/oib/AITBC

[Timer]
# Rate staleness window is ENERGY_MAX_RATE_AGE_SECONDS (86400s); refreshing
# every 12h keeps observed_at at half the allowed age with slack for a
# missed run.
OnCalendar=*-*-* 00/12:00:00
RandomizedDelaySec=900
Persistent=true
Unit=aitbc-native-energy-rate-refresh.service

[Install]
WantedBy=timers.target
