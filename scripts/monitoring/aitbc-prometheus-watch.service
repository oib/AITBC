[Unit]
Description=AITBC Prometheus alert watcher
Documentation=https://github.com/oib/AITBC
After=network.target prometheus.service

[Service]
Type=simple
User=aitbc
Group=aitbc
WorkingDirectory=/opt/aitbc
Environment=PATH=/opt/aitbc/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional per-node tuning without editing this unit -- the env keys feed the
# watcher's click envvars (missing file is fine, "-" prefix):
#   AITBC_WATCH_INTERVAL=15            poll interval; keep WatchdogSec >= 5x this
#                                      (15x5=75 is the floor; 300 below is the
#                                      margin for a saturated box)
#   AITBC_WATCH_NOTIFY_URL="..."       space-separated webhook URLs
#   AITBC_WATCH_NOTIFY_MIN_SEVERITY=.. push floor: info|warning|critical; lower
#                                      severities stay in the alert log for the
#                                      daily digest (SD-2); unset = push all
#   AITBC_WATCH_SILENCE_FILE=...       JSON silence file, reloaded each poll
#   AITBC_WATCH_REMIND_INTERVAL=0      still-firing reminder cadence (seconds)
#   AITBC_WATCH_METRICS_FILE=...       node-exporter textfile heartbeat path
EnvironmentFile=-/etc/aitbc/prometheus-watch.env
# --alert-log stays on the command line (a deployment constant, not a tuning
# knob); everything else comes from the defaults or the env file above.
ExecStart=/opt/aitbc/venv/bin/aitbc prometheus alerts --watch --alert-log /var/log/aitbc/alerts.log
Restart=on-failure
OOMScoreAdjust=500
RestartSec=10
# Restart a hung watcher, not just a crashed one: the CLI pings WATCHDOG=1 at
# the top of each poll, after the Prometheus query, and after every notify
# attempt while NOTIFY_SOCKET is set, so a slow-but-alive iteration stays fed.
# 75s proved too tight -- during the 22 Oct OOM pressure a single iteration
# (query + notify retries) outlasted it and systemd killed the watcher with
# SIGABRT 21 times. A genuinely hung process still gets caught: worst case is
# WatchdogSec plus the longest bounded step (~60s notify budget), i.e. a hang
# is detected within ~6 minutes.
WatchdogSec=300

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ProtectSystem=strict makes /var read-only too, so the rotating log file needs an
# explicit hole; without it configure_logging() falls back to journal-only.
ReadWritePaths=/tmp /var/log/aitbc
# Uncomment when AITBC_WATCH_METRICS_FILE points into the node-exporter textfile
# directory (which also needs `setfacl -m u:aitbc:rwx` or group write for aitbc).
#ReadWritePaths=/var/lib/prometheus/node-exporter

[Install]
WantedBy=multi-user.target
